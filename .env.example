# AutoRoll System Configuration Template
# Copy this file to .env before running services

# Environment
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Central FastAPI Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_KEY=change-this-super-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
# For single-node SQLite: sqlite:///./autoroll.db
# For production PostgreSQL: postgresql://user:password@localhost:5432/autoroll_db
DATABASE_URL=sqlite:///./autoroll.db

# Vector Index Settings
VECTOR_DIMENSION=512
SIMILARITY_THRESHOLD=0.65
LIVENESS_THRESHOLD=0.90
MODEL_VERSION=arcface_iresnet50_v1

# Worker Node Settings
WORKER_ID=worker-node-01
WORKER_HOST=127.0.0.1
WORKER_PORT=8001
SERVER_WS_URL=ws://127.0.0.1:8000/ws/workers
MAX_CAMERAS=4
DEVICE_TYPE=cpu

# Camera & Storage Settings
ENROLLMENT_STORAGE_DIR=./data/enrollments
TEMP_STORAGE_DIR=./data/tmp
ALLOW_RAW_IMAGE_STORAGE=false
